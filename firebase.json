{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "site": "poltekom-ess",
    "public": "frontend",
    "ignore": [
      "firebase.json",
      "**/.*",
      "lib/**",
      "android/**",
      "web/**",
      "test/**",
      "build/**",
      "pubspec.*",
      "analysis_options.yaml"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
