# =============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (BACKEND & AI GATEWAY)
# Salin file ini menjadi .env dan isi dengan kredensial rahasia Anda
# =============================================================================

# --- Firebase Realtime Database (Hot Buffer) ---
# Wajib diisi (TD-B03 Fail-Fast): Backend menolak start jika kosong
FIREBASE_RTDB_URL=https://environmental-sensing-f6e1c-default-rtdb.asia-southeast1.firebasedatabase.app/telemetry/buffer.json
# Token autentikasi / Database Secret Firebase RTDB (SEC-02).
# Kosongkan jika database rules terbuka, atau isi dengan Database Secret jika auth != null aktif
FIREBASE_RTDB_AUTH=your_firebase_rtdb_secret_here

# --- Supabase PostgreSQL (Warm Analytics) ---
# Wajib diisi (TD-B03 Fail-Fast): Backend menolak start jika kosong
SUPABASE_URL=https://lrnmbhobpymxmzocrfto.supabase.co
SUPABASE_KEY=sb_secret_your_secret_key_here
TABLE_LOGS=ess_logs
TABLE_ANOMALIES=ess_anomalies

# --- Google Gemini AI API ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-flash-lite-latest

# --- Backend Server Config ---
PORT=8000
HOST=0.0.0.0
ADMIN_API_KEY=ess-secret-admin-key-2026
CHAT_RATE_LIMIT_PER_MINUTE=15

